{
  "name": "spreadsheet-agent-assessment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "bench": "node scripts/bench.mjs",
    "auth": "clasp login",
    "open:script": "clasp open-script",
    "format": "prettier --write Code.gs scripts README.md package.json appsscript.json",
    "format:check": "prettier --check Code.gs scripts README.md package.json appsscript.json",
    "setup": "node scripts/setup.mjs",
    "setup:offline": "node offline/setup.mjs",
    "bench:offline": "cd offline && npm run --silent bench:offline",
    "test:offline": "cd offline && npm test"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}